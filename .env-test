# =============================================================
# TEST FILE ONLY — copy values you like into your real .env
# (cp .env-test .env then edit). Never commit real secrets.
# All values below are FAKE placeholders.
# =============================================================

# --- Backend ---
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Directory for the SQLite database, history, backups and secrets
DATA_DIR=./data

# true = simulated telemetry (default). false = live Proxmox VE data.
MOCK_MODE=false

# Simulation tick / WebSocket push cadence (ms)
TELEMETRY_INTERVAL_MS=2000
# Seeded history retention window (hours)
HISTORY_RETENTION_HOURS=24

# --- Proxmox VE provider (MOCK_MODE=false) ---
PROXMOX_HOST=192.168.1.10:8006
PROXMOX_TOKEN_ID=root@pam!homelab
PROXMOX_TOKEN_SECRET=CHANGE_ME_fake_token_secret_only_for_testing
PROXMOX_VERIFY_TLS=false
PROXMOX_POLL_INTERVAL_MS=5000

# --- Security ---
# Set BEFORE adding any integration credentials, else re-encrypt
# (dashboardctl rotate-secrets) or re-add the credentials.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_to_a_long_random_password_at_least_10_chars
SECRET_ENCRYPTION_KEY=CHANGE_ME_to_a_long_random_string_of_32_plus_characters_0000000000

COOKIE_SECURE=false
NODE_ENV=development

# --- Frontend (build-time / dev) ---
VITE_BACKEND_URL=/api
VITE_WS_URL=
